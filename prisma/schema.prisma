generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id          String            @id @default(cuid())
  name        String
  phone       String            @unique
  password    String            @default("")
  grade       String
  status      String            @default("pending")
  parentName  String
  parentPhone String
  loginCount  Int               @default(0)
  lastLogin   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  examResults ExamResult[]
  activities  StudentActivity[]
  payments    Payment[]
}

model StudentActivity {
  id        String   @id @default(cuid())
  studentId String
  action    String
  details   String?
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Video {
  id        String    @id @default(cuid())
  title     String
  url       String?
  filePath  String?
  fileType  String?
  thumbnail String?
  grade     String
  price     Float?    @default(0)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Homework {
  id            String    @id @default(cuid())
  title         String
  content       String
  filePath      String?
  fileType      String?
  thumbnail     String?
  answerKeyPath String?
  answerKeyType String?
  grade         String
  questions     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Exam {
  id            String    @id @default(cuid())
  title         String
  content       String
  filePath      String?
  fileType      String?
  thumbnail     String?
  answerKeyPath String?
  answerKeyType String?
  grade         String
  questions     String?
  passScore     Float?    @default(50)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  results       ExamResult[]
}

model ExamResult {
  id          String    @id @default(cuid())
  examId      String
  studentId   String
  score       Float?
  maxScore    Float?    @default(100)
  submittedAt DateTime  @default(now())
  student     Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam        Exam      @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  grade     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discussion {
  id           String   @id @default(cuid())
  studentId    String
  studentName  String
  grade        String
  content      String
  isAdminReply Boolean  @default(false)
  likes        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String?
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  filePath  String
  fileType  String
  fileSize  String?
  category  String?
  data      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoProgress {
  id             String    @id @default(cuid())
  studentId      String
  videoId        String
  watchedSeconds Float?    @default(0)
  totalSeconds   Float?    @default(0)
  completed      Boolean   @default(false)
  lastWatchedAt  DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([studentId, videoId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String?
  filePath  String?
  type      String?
  videoUrl  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id           String    @id @default(cuid())
  studentId    String
  studentName  String?
  studentPhone String?
  studentGrade String?
  method       String?
  amount       Float?    @default(0)
  videoId      String?
  videoTitle   String?
  receiptPath  String?
  receiptType  String?
  status       String    @default("pending")
  note         String?
  reviewedAt   DateTime?
  reviewedBy   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  student      Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model VideoAccess {
  id        String   @id @default(cuid())
  videoId   String
  studentId String
  grantedBy String   @default("admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([videoId, studentId])
}
