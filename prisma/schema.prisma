generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Student {
  id          String            @id @default(cuid())
  name        String
  phone       String            @unique
  grade       String
  status      String            @default("pending")
  parentName  String
  parentPhone String
  loginCount  Int               @default(0)
  lastLogin   DateTime?
  isPaidAccess Boolean          @default(false)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  examResults ExamResult[]
  activities  StudentActivity[]
}

model StudentActivity {
  id        String   @id @default(cuid())
  studentId String
  action    String
  details   String   @default("")
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Video {
  id        String   @id @default(cuid())
  title     String
  url       String   @default("")
  filePath  String   @default("")
  fileType  String   @default("")
  thumbnail String   @default("")
  grade     String
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Homework {
  id            String   @id @default(cuid())
  title         String
  content       String
  filePath      String   @default("")
  fileType      String   @default("")
  thumbnail     String   @default("")
  answerKeyPath String   @default("")
  answerKeyType String   @default("")
  grade         String
  questions     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Exam {
  id            String       @id @default(cuid())
  title         String
  content       String
  filePath      String       @default("")
  fileType      String       @default("")
  thumbnail     String       @default("")
  answerKeyPath String       @default("")
  answerKeyType String       @default("")
  grade         String
  questions     String       @default("")
  passScore     Float        @default(50)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     updatedAt
  results       ExamResult[]
}

model ExamResult {
  id          String   @id @default(cuid())
  examId      String
  studentId   String
  score       Float
  maxScore    Float    @default(100)
  submittedAt DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  grade     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discussion {
  id           String   @id @default(cuid())
  studentId    String
  studentName  String
  grade        String
  content      String
  isAdminReply Boolean  @default(false)
  likes        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String   @default("")
  updatedAt DateTime @updatedAt
}

model Media {
  id        String   @id @default(cuid())
  filename  String
  filePath  String
  fileType  String
  fileSize  String   @default("")
  category  String   @default("general")
  data      String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model VideoProgress {
  id             String   @id @default(cuid())
  studentId      String
  videoId        String
  watchedSeconds Float    @default(0)
  totalSeconds   Float    @default(0)
  completed      Boolean  @default(false)
  lastWatchedAt  DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([studentId, videoId])
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String   @default("")
  filePath  String   @default("")
  type      String   @default("image")
  videoUrl  String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Payment {
  id           String   @id @default(cuid())
  studentId    String
  studentName  String   @default("")
  videoId      String   @default("")
  videoTitle   String   @default("")
  amount       Float    @default(0)
  method       String   @default("")
  receiptPath  String   @default("")
  status       String   @default("pending")
  note         String   @default("")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}
