// This is your Prisma schema file.
// Learn more: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ===== المستخدمين =====
model User {
  id            String    @id @default(cuid())
  name          String
  email         String    @unique
  password      String
  role          String    @default("student") // "admin" or "student"
  phone         String?
  grade         String?   // الصف الدراسي
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  homeworkResults HomeworkResult[]
  examResults     ExamResult[]
  payments        Payment[]
  videoAccess     VideoAccess[]

  @@index([email])
  @@index([role])
}

// ===== الفيديوهات =====
model Video {
  id          String   @id @default(cuid())
  title       String
  description String?
  url         String   // رابط YouTube أو أي رابط
  thumbnailUrl String?
  subject     String?  // المادة
  grade       String?  // الصف
  order       Int      @default(0)
  isPublished Boolean  @default(false)
  price       Float?   @default(0) // السعر — null أو 0 = مجاني
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    Payment[]
  videoAccess VideoAccess[]
}

// ===== الواجبات =====
model Homework {
  id          String     @id @default(cuid())
  title       String
  description String?
  subject     String?
  grade       String?
  dueDate     DateTime?
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions       Question[]
  homeworkResults HomeworkResult[]
}

// ===== الامتحانات =====
model Exam {
  id          String     @id @default(cuid())
  title       String
  description String?
  subject     String?
  grade       String?
  duration    Int?       // المدة بالدقائق
  isPublished Boolean    @default(false)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions    Question[]
  examResults  ExamResult[]
}

// ===== الأسئلة =====
model Question {
  id            String    @id @default(cuid())
  text          String
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  correctAnswer String
  explanation   String?   // شرح الحل — من الذكاء الاصطناعي
  homeworkId    String?
  examId        String?
  homework      Homework? @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  exam          Exam?     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([homeworkId])
  @@index([examId])
}

// ===== نتائج الواجبات =====
model HomeworkResult {
  id              String   @id @default(cuid())
  studentId       String
  homeworkId      String
  score           Int
  totalQuestions  Int
  questionDetails String   // JSON: تفاصيل كل سؤال
  createdAt       DateTime @default(now())

  student  User     @relation(fields: [studentId], references: [id])
  homework Homework @relation(fields: [homeworkId], references: [id])

  @@unique([studentId, homeworkId])
  @@index([studentId])
  @@index([homeworkId])
}

// ===== نتائج الامتحانات =====
model ExamResult {
  id              String   @id @default(cuid())
  studentId       String
  examId          String
  score           Int
  totalQuestions  Int
  questionDetails String   // JSON: تفاصيل كل سؤال
  createdAt       DateTime @default(now())

  student User @relation(fields: [studentId], references: [id])
  exam    Exam @relation(fields: [examId], references: [id])

  @@unique([studentId, examId])
  @@index([studentId])
  @@index([examId])
}

// ===== المدفوعات =====
model Payment {
  id          String   @id @default(cuid())
  studentId   String
  videoId     String
  method      String   // "fawry" | "instapay" | "vodafone_cash"
  amount      Float
  receiptPath String?  // مسار صورة الإيصال
  status      String   @default("pending") // "pending" | "approved" | "rejected"
  adminNote   String?  // ملاحظات الأدمن
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  student User  @relation(fields: [studentId], references: [id])
  video   Video @relation(fields: [videoId], references: [id])

  @@index([studentId])
  @@index([videoId])
  @@index([status])
}

// ===== صلاحية الوصول للفيديو =====
model VideoAccess {
  id        String   @id @default(cuid())
  studentId String
  videoId   String
  grantedBy String?  // email الأدمن اللي منح الوصول
  createdAt DateTime @default(now())

  student User  @relation(fields: [studentId], references: [id])
  video   Video @relation(fields: [videoId], references: [id])

  @@unique([studentId, videoId])
  @@index([studentId])
  @@index([videoId])
}

// ===== إعدادات الموقع =====
model SiteConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String

  @@index([key])
}
