// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String   @default("")
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String @default("")
}

model Student {
  id           String            @id @default(cuid())
  name         String
  phone        String            @unique
  grade        String
  status       String            @default("pending")
  parentName   String
  parentPhone  String
  isFreeAccess Boolean           @default(true)
  loginCount   Int               @default(0)
  lastLogin    DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  examResults  ExamResult[]
  activities   StudentActivity[]
}

model StudentActivity {
  id        String   @id @default(cuid())
  studentId String
  action    String
  details   String   @default("")
  createdAt DateTime @default(now())
  student   Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model Video {
  id        String   @id @default(cuid())
  title     String
  url       String   @default("")
  filePath  String   @default("")
  fileType  String   @default("")
  thumbnail String   @default("")
  grade     String
  price     Float    @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Homework {
  id            String   @id @default(cuid())
  title         String
  content       String
  filePath      String   @default("")
  fileType      String   @default("")
  thumbnail     String   @default("")
  answerKeyPath String   @default("")
  answerKeyType String   @default("")
  grade         String
  questions     String   @default("")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Exam {
  id            String       @id @default(cuid())
  title         String
  content       String
  filePath      String       @default("")
  fileType      String       @default("")
  thumbnail     String       @default("")
  answerKeyPath String       @default("")
  answerKeyType String       @default("")
  grade         String
  questions     String       @default("")
  passScore     Float        @default(50)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  results       ExamResult[]
}

model ExamResult {
  id          String   @id @default(cuid())
  examId      String
  studentId   String
  score       Float
  maxScore    Float    @default(100)
  submittedAt DateTime @default(now())
  student     Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  content   String
  grade     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Discussion {
  id           String   @id @default(cuid())
  studentId    String
  studentName  String
  grade        String
  content      String
  isAdminReply Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GalleryImage {
  id        String   @id @default(cuid())
  title     String   @default("")
  filePath  String   @default("")
  type      String   @default("image")
  videoUrl  String   @default("")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
}
