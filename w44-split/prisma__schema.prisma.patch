+// ============================================================
+// (2026-و44) الإشعارات — طلب المستر: «أي حاجة يتضاف تظهر له إشعار للطالب»:
+//   • الأدمن رد على شكوى → الطالب ياخد إشعار «شكواك اتحلت/اترد عليها»
+//   • كتاب/ملزمة جديدة → إشعار للطلاب (حسب الصف)
+//   • امتحان/واجب/إعلان جديد → إشعار للطلاب المستهدفين
+// read=true يعني الطالب شافه — العداد بيبقى unreadCount بس
+// ============================================================
+model Notification {
+  id        String   @id @default(cuid())
+  studentId String
+  type      String   @default("general") // complaint_reply | book | exam | homework | announcement | general
+  title     String
+  body      String   @default("")
+  read      Boolean  @default(false)
+  createdAt DateTime @default(now())
+  updatedAt DateTime @updatedAt
+
+  @@index([studentId, read])
+  @@index([createdAt])
+}
+
