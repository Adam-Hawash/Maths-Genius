-var MAX_IMAGES = 4
-var MAX_B64_LENGTH = 7000000 // ~5MB binary after base64
-var DATA_URL_RE = /^data:(image\/[a-zA-Z0-9.+-]+);base64,([\s\S]+)$/
-var MAX_HISTORY = 10 // آخر 10 رسائل (5 أدوار) بتبني سياق المحادثة
